{
  "name": "it-ipa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "gen:sample": "node tools/gen-sample-glb.mjs",
    "deploy": "npm run build && npx --yes wrangler@4 pages deploy dist --project-name it-ipa-3dgame --branch main --commit-dirty=true"
  },
  "dependencies": {
    "@babylonjs/core": "^9.30.0",
    "@babylonjs/loaders": "^9.30.0",
    "idb": "^8.0.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
